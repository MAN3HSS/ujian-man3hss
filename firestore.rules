rules_version = '2';

// PORTAL UJIAN MAN 3 HULU SUNGAI SELATAN — Firestore Security Rules
//
// Prinsip:
// - Siswa (belum login) HANYA boleh: baca ujian & kelas, membuat sesi ujian
//   & pelanggaran, dan mengubah sesi miliknya sendiri (via app logic).
// - Semua operasi tulis/hapus untuk data master (exams, classes, students)
//   dan operasi admin (monitoring, hapus sesi/pelanggaran) HANYA boleh oleh
//   user yang sudah login (Firebase Auth = akun admin/proktor).
//
// Catatan: aturan ini cukup permisif untuk sesi & pelanggaran (create oleh
// siapa saja) karena siswa mengakses tanpa login — mirroring cara kerja
// aplikasi ini sebelumnya. Untuk keamanan lebih ketat, pertimbangkan
// menambahkan validasi field pada create.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Validasi ketat untuk ujian yang dibuat GURU TANPA LOGIN lewat fitur
    // "Scan Barcode / Link Ujian" (link Google Form baru). Guru cuma bisa
    // membuat dokumen ujian baru dengan bentuk data spesifik ini — TIDAK
    // bisa mengubah/menghapus ujian manapun (itu tetap khusus Admin), dan
    // tidak bisa membuat ujian yang diikat ke kelas tertentu.
    function isValidSelfServiceExam() {
      let d = request.resource.data;
      return d.created_via == 'guru_link_mandiri'
        && d.status == 'active'
        && d.classes is list && d.classes.size() == 0
        && d.form_url is string && d.form_url.size() > 0 && d.form_url.size() < 500
        && d.subject is string && d.subject.size() > 0 && d.subject.size() < 150
        && d.title is string
        && d.duration_minutes is number && d.duration_minutes > 0 && d.duration_minutes <= 300
        && d.token_masuk_plain == ''
        && d.max_violations is number;
    }

    // Data master ujian: publik boleh baca (untuk cek jadwal/token).
    // Admin boleh tulis/ubah/hapus apapun. Guru (tanpa login) HANYA boleh
    // membuat ujian baru lewat link Google Form (bentuk data dibatasi
    // ketat oleh isValidSelfServiceExam), tidak bisa ubah/hapus.
    match /exams/{examId} {
      allow read: if true;
      allow create: if isAdmin() || isValidSelfServiceExam();
      allow update, delete: if isAdmin();
    }

    // Kelas: publik boleh baca, admin yang kelola.
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Data siswa: publik boleh baca (untuk pencocokan nama saat login ujian),
    // hanya admin yang boleh tulis/ubah/hapus.
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Sesi ujian: siswa boleh membuat sesi baru & memperbarui sesinya sendiri
    // (progres, pelanggaran, status selesai). Admin boleh baca semua & hapus.
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Pelanggaran: siswa (via app) boleh mencatat pelanggaran pada sesinya,
    // admin boleh baca & hapus.
    match /violations/{violationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Pengaturan global (jeda ujian, tahun ajaran, dll): publik boleh baca,
    // hanya admin yang boleh ubah.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profil admin (nama, role): hanya pemilik akun & admin lain yang login
    // boleh baca/tulis profil miliknya.
    match /profiles/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.auth.uid == userId;
    }
  }
}
